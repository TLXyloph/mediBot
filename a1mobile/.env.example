# Safe hackathon defaults. Mock mode never places a real phone call.
HOST=0.0.0.0
PORT=4320
PUBLIC_BASE_URL=http://localhost:4320

# Gemini determines receiving requirements. Leave mock=true for an offline demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash
GEMINI_MOCK=true

# Convex remains the append-only event spine.
CONVEX_URL=
CONVEX_APPEND_FUNCTION=events:append
CONVEX_PATIENT_STATE_FUNCTION=events:patientState
CONVEX_SBAR_FUNCTION=events:sbar
CONVEX_MOCK=true

# Switch to rest only after a1mobile provides its official API contract.
A1MOBILE_PROVIDER=mock
A1MOBILE_API_BASE_URL=
A1MOBILE_API_KEY=
A1MOBILE_AGENT_ID=
A1MOBILE_CALL_PATH=/v1/calls
A1MOBILE_MESSAGE_PATH=/v1/messages
A1MOBILE_WEBHOOK_SECRET=
A1MOBILE_ALLOW_REAL_CALLS=false
A1MOBILE_MOCK_DELAY_MS=700

# Comma separated. Only these numbers may be dialed in real mode.
A1MOBILE_ALLOWED_NUMBERS=
