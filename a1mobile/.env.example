# Safe hackathon defaults. Mock mode never places a real phone call.
HOST=0.0.0.0
PORT=4320
PUBLIC_BASE_URL=http://localhost:4320

# Gemini determines receiving requirements. Leave mock=true for an offline demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash
GEMINI_MOCK=true

# Convex remains the append-only event spine.
CONVEX_URL=
CONVEX_APPEND_FUNCTION=events:append
CONVEX_PATIENT_STATE_FUNCTION=events:patientState
CONVEX_SBAR_FUNCTION=events:sbar
CONVEX_MOCK=true

# The hack API uses X-Team-Key. Keep mock mode until a public HTTPS voice URL
# and OTP-verified destination numbers are ready.
A1MOBILE_PROVIDER=mock
A1MOBILE_API_BASE_URL=https://hack.a1mobile.com/api
A1MOBILE_TEAM_KEY=
A1MOBILE_PHONE_NUMBER=
A1MOBILE_SIP_USERNAME=
A1MOBILE_SIP_PASSWORD=
A1MOBILE_VOICE_WEBHOOK_URL=
A1MOBILE_SMS_WEBHOOK_URL=
A1MOBILE_AUTO_POINT=false
A1MOBILE_ALLOW_REAL_CALLS=false
A1MOBILE_MOCK_DELAY_MS=700

# Comma separated. Each number must also be OTP-verified with a1mobile.
A1MOBILE_ALLOWED_NUMBERS=
A1MOBILE_ADMIN_TOKEN=
