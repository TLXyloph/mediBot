# Copy to eyes/.env and fill. Server-only values — never expose through VITE_*.
GEMINI_API_KEY=replace-with-the-team-ai-studio-key

# Convex deployment URL shared by lane B (same value voice/ and screens/ use).
CONVEX_URL=https://your-deployment.convex.cloud

# --- optional overrides (defaults shown; the defaults are CORRECT — only set
# these if brain/ renames its functions) ---
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_VISION_MODEL=gemini-3.6-flash
# CONVEX_APPEND_FUNCTION=events:append
# CONVEX_PATIENT_STATE_FUNCTION=patientState:patientState

# Explicit local-development escape hatch. Never use this for the demo.
CONVEX_MOCK=false

HOST=0.0.0.0
# On MB1 use 8127 — an unrelated service occupies 8123/3000-range ports there.
PORT=3000
