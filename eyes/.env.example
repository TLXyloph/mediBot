# Server-only. Never expose this value through a VITE_ variable.
GEMINI_API_KEY=replace-with-a-rotated-ai-studio-key

GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VISION_MODEL=gemini-3.6-flash

CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_APPEND_FUNCTION=events:append
CONVEX_PATIENT_STATE_FUNCTION=events:patientState

# Explicit local-development escape hatch. Never use this for the demo.
CONVEX_MOCK=false

HOST=0.0.0.0
PORT=3000
