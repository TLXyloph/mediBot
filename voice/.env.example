# MediBot Lane A (voice/). Copy to voice/.env and fill. NEVER commit voice/.env.
# Team Gemini key (paid, AI Studio):
GEMINI_API_KEY=
# Convex deployment URL from lane B (Phase 0 share). Leave empty for local
# JSONL dev mode (events go to voice/.data/events.log).
CONVEX_URL=

# --- optional overrides (defaults shown) ---
# EARS_MODEL=gemini-3.1-flash-live-preview
# TTS_ENGINE=gemini        # gemini (say fallback) | say (skip Gemini TTS)
# TTS_MODEL=gemini-2.5-flash-preview-tts
# TTS_VOICE=Kore           # Gemini prebuilt voice
# SAY_VOICE=               # macOS `say -v` voice for the fallback
# TTS_TIMEOUT_MS=2000
# MIC_BACKEND=auto         # auto | ffmpeg | sox
# MIC_DEVICE=default       # ffmpeg avfoundation device; try 0 if default fails
# CMD_PORT=4750            # localhost command server (VoiceOS MCP → here)
# IDLE_FLUSH_MS=1200       # transcript idle gap that closes an utterance
